# Copy to `frontend/.env.local` (this file lives next to the Next.js app). See `src/lib/booking-env.ts` for Resend / public URL vars.

# Page transition between routes: omit or `default` (dim + logo), or `slide` (full-screen slide up / exit up)
# NEXT_PUBLIC_PAGE_TRANSITION_VARIANT=slide

# --- Supabase Postgres (local dev + production)
# Dashboard → Project Settings → Database → Connection string. Use the
# **Transaction pooler** URI (port 6543) for the serverless Next.js app — not
# the direct (port 5432) connection. Example shape:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
#
# • URL-encode special characters in the password.
# • `resolveDatabaseUrl` in `src/lib/db.ts` adds pgbouncer=true / sslmode for pooler.supabase.com if missing.
# • Apply migrations once via Supabase SQL Editor (or psql on the session/direct URI):
#     ../backend/migrations/001_bookings.sql
#     ../backend/migrations/002_client_onboarding.sql
# • Use separate Supabase projects for staging vs prod if you want isolation; the URL shape is identical.
DATABASE_URL=

# --- Supabase Auth (required for /client/* magic-link login; same project as DATABASE_URL)
# Dashboard → Project Settings → API: Project URL + anon public key (not the service_role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Booking (required for POST /api/book-meeting)
BOOKING_ORGANIZER_EMAIL=you@yourdomain.com
BOOKING_TIMEZONE=America/Santiago

# Optional whole-day blocks: comma-separated YYYY-MM-DD
# BOOKING_BLOCKED_DATES=2026-04-18,2026-04-19

# Optional manual busy slots (same shape CalDAV uses in the API)
# BOOKING_BUSY_SLOTS_JSON={"2026-04-10":["10:00","14:30"]}

# --- iCloud CalDAV (optional; reads busy intervals for /api/booking-availability)
# 1. Apple ID → Sign-In & Security → App-Specific Passwords → generate one.
# 2. Set all three below.
BOOKING_ICLOUD_CALDAV_ENABLED=true
ICLOUD_APPLE_ID=
ICLOUD_APP_SPECIFIC_PASSWORD=
# Exact calendar name in Apple Calendar (recommended). If empty, the first CalDAV calendar is used.
ICLOUD_CALDAV_CALENDAR_NAME=
# ICLOUD_CALDAV_CALENDAR_URL=

# Email / ICS (see booking-env.ts)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# BOOKING_PUBLIC_BASE_URL=http://localhost:3000  (use localhost, not http://0.0.0.0:3000 — cookies break)
# Any mentemaestra.space value is rewritten to mentemaestra.studio. On Vercel Production, if unset, links default to https://mentemaestra.studio.

# --- Client onboarding CRM (see src/lib/onboarding-env.ts and docs/client-access-onboarding-crm.md)
# Required to unlock /internal/* and /api/internal/*; middleware fails closed if unset.
CRM_BASIC_AUTH_USER=
CRM_BASIC_AUTH_PASS=
# Optional knobs
# ONBOARDING_INVITE_TTL_DAYS=30
# ONBOARDING_TOKEN_HASH_PEPPER=
# ONBOARDING_PUBLIC_BASE_URL=http://localhost:3000  (same: avoid 0.0.0.0 in links)
# Production: set to https://mentemaestra.studio so invite/magic-link emails use the real domain (not VERCEL_URL / localhost).
# ONBOARDING_SUPPORT_EMAIL=soporte@mentemaestra.studio  (default if unset; separate from BOOKING_ORGANIZER_EMAIL)
# RESEND_ONBOARDING_TEMPLATE_ID=

# --- Client portal session secret (HMAC key for signed access links + cookies)
# Required. Must be at least 32 chars. Rotate to invalidate every outstanding
# welcome link and portal session at once. Generate with:
#   openssl rand -hex 32
PORTAL_SESSION_SECRET=
# Optional. `true` forces Secure cookies; `false` disables (e.g. http:// dev). Default: Secure when NODE_ENV=production.
# PORTAL_SESSION_COOKIE_SECURE=true

# --- Notion integration (client portal — server-side only)
# Create an internal integration at https://www.notion.so/my-integrations,
# then share the project database with it ("Connections" on the DB).
NOTION_API_KEY=

# --- PageSpeed Insights (optional — client portal /client/*/gsc card)
# Use any Google Cloud API key from a project where “PageSpeed Insights API” is enabled
# (can be the SAME key as other Google APIs — set one of these vars to that key string).
# GOOGLE_PAGESPEED_API_KEY=
# Aliases: PAGESPEED_INSIGHTS_API_KEY=  or  GOOGLE_API_KEY=

# --- Google Search Console (GSC) integration (optional — internal CRM + client portal /gsc)
# 1) Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# 2) Enable “Google Search Console API”
# 3) Authorized redirect URI should be:
#      <ONBOARDING_PUBLIC_BASE_URL>/api/internal/gsc/oauth/callback
#    (If ONBOARDING_PUBLIC_BASE_URL is unset, it falls back to BOOKING_PUBLIC_BASE_URL / VERCEL_URL / localhost)
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# Optional override (full URL). Prefer leaving this unset and controlling the origin via ONBOARDING_PUBLIC_BASE_URL.
# GSC_REDIRECT_URI=
# Encryption key for refresh tokens (32-byte hex). Generate with: openssl rand -hex 32
# GSC_TOKEN_ENCRYPTION_KEY=
