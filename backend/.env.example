# Optional: only needed if you want to run `psql "$DATABASE_URL" -f migrations/NNN_*.sql`
# from this folder instead of pasting into the Supabase SQL Editor.
#
# Use the **Session mode** (or direct, port 5432) connection string from
# Supabase → Project Settings → Database → Connection string. The **transaction
# pooler** (port 6543) is for the serverless Next.js app, not for psql.
#
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
