# Copy to `.env.local`. See `src/lib/booking-env.ts` for Resend / public URL vars.

# Page transition between routes: omit or `default` (dim + logo), or `slide` (full-screen slide up / exit up)
# NEXT_PUBLIC_PAGE_TRANSITION_VARIANT=slide

# --- Supabase Postgres (local dev + production)
# Dashboard → Project Settings → Database. Use the **Transaction pooler** URI (port 6543),
# not the direct connection, for serverless Next.js. Example shape:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
#
# • URL-encode special characters in the password.
# • `resolveDatabaseUrl` in `src/lib/db.ts` adds pgbouncer=true / sslmode for pooler.supabase.com if missing.
# • Run `backend/migrations/001_bookings.sql` once in the Supabase SQL editor.
# • Optional: separate Supabase projects for staging vs prod; same URL shape for local `.env.local`.
DATABASE_URL=

# Booking (required for POST /api/book-meeting)
BOOKING_ORGANIZER_EMAIL=you@yourdomain.com
BOOKING_TIMEZONE=America/Santiago

# Optional whole-day blocks: comma-separated YYYY-MM-DD
# BOOKING_BLOCKED_DATES=2026-04-18,2026-04-19

# Optional manual busy slots (same shape CalDAV uses in the API)
# BOOKING_BUSY_SLOTS_JSON={"2026-04-10":["10:00","14:30"]}

# --- iCloud CalDAV (optional; reads busy intervals for /api/booking-availability)
# 1. Apple ID → Sign-In & Security → App-Specific Passwords → generate one.
# 2. Set all three below.
BOOKING_ICLOUD_CALDAV_ENABLED=true
ICLOUD_APPLE_ID=
ICLOUD_APP_SPECIFIC_PASSWORD=
# Exact calendar name in Apple Calendar (recommended). If empty, the first CalDAV calendar is used.
ICLOUD_CALDAV_CALENDAR_NAME=
# ICLOUD_CALDAV_CALENDAR_URL=

# Email / ICS (see booking-env.ts)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# BOOKING_PUBLIC_BASE_URL=http://localhost:3000
